#include <stdio.h>

int main()
{
    int n, k, i;

    scanf("%d", &n);

    int arr[n];

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &k);

    int sum = 0;

    // Calculate sum of first k elements
    for (i = 0; i < k; i++)
    {
        sum += arr[i];
    }

    int maxSum = sum;

    // Sliding window
    for (i = k; i < n; i++)
    {
        sum = sum + arr[i] - arr[i - k];

        if (sum > maxSum)
        {
            maxSum = sum;
        }
    }

    printf("%d", maxSum);

    return 0;
}
