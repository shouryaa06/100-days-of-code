#include <iostream>
#include <cmath>

using namespace std;

int main() {
    int totalRows = 7;
    int peakRow = 4; // Middle row (7 + 1) / 2

    // Outer loop for each row
    for (int i = 1; i <= totalRows; ++i) {
        
        // Calculate spaces and stars using absolute difference from the peak row
        int spacesCount = abs(peakRow - i);
        int starsCount = totalRows - 2 * spacesCount;

        // Inner loop 1: Print leading spaces
        for (int space = 1; space <= spacesCount; ++space) {
            cout << " ";
        }

        // Inner loop 2: Print stars
        for (int star = 1; star <= starsCount; ++star) {
            cout << "*";
        }

        // Move to the next line after completing the row
        cout << endl;
    }

    return 0;
}

