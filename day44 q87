#include <stdio.h>
#include <ctype.h>


void count_string_elements(const char str[], int *space_count, int *digit_count, int *special_char_count) {
    // Initialize all counts to 0
    *space_count = 0;
    *digit_count = 0;
    *special_char_count = 0;
    
    int i = 0;
    while (str[i] != '\0') {
        unsigned char ch = (unsigned char)str[i];
        
        if (isspace(ch)) {
            (*space_count)++;
        } 
        else if (isdigit(ch)) {
            (*digit_count)++;
        } 
        else if (!isalpha(ch)) {
            // If it is not a space, not a digit, and not alphabetical,
            // it is a special character (e.g. @, #, !, ., etc.)
            (*special_char_count)++;
        }
        
        i++;
    }
}

