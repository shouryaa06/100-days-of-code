#include <iostream>
#include <iomanip>

using namespace std;

int main() {
    int n;
    cout << "Enter the number of terms (n): ";
    if (!(cin >> n) || n <= 0) {
        cout << "Please enter a valid positive integer." << endl;
        return 1;
    }

    double sum = 0.0;

    for (int i = 1; i <= n; ++i) {
        double numerator = 2.0 * i;
        double denominator = 4.0 * i - 1.0;
        sum += numerator / denominator;
    }

    // Print result with high precision (6 decimal places)
    cout << fixed << setprecision(6);
    cout << "Sum of " << n << " terms is: " << sum << endl;

    return 0;
}
