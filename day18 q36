#include <stdio.h>
#include <stdlib.h> // Required for abs()

int main() {
    int num1, num2, a, b;

    // Prompt user for input
    printf("Enter two integers: ");
    if (scanf("%d %d", &num1, &num2) != 2) {
        printf("Invalid input. Please enter integers only.\n");
        return 1;
    }

    // Work with absolute values to correctly handle negative inputs
    a = abs(num1);
    b = abs(num2);

    // Handle edge case where both inputs are zero
    if (a == 0 && b == 0) {
        printf("HCF of 0 and 0 is undefined.\n");
        return 0;
    }

    // Euclidean Algorithm (Repeated Division)
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }

    printf("The HCF (GCD) of %d and %d is: %d\n", num1, num2, a);

    return 0;
}

