#include <stdio.h>

#define MAX_ROWS 100
#define MAX_COLS 100


void read_matrix(int matrix[MAX_ROWS][MAX_COLS], int rows, int cols) {
    printf(" Enter the elements of the matrix (%d x %d):\n", rows, cols);
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            printf("Element [%d][%d]: ", i, j);
            scanf("%d", &matrix[i][j]);
        }
    }
}


void print_matrix(int matrix[MAX_ROWS][MAX_COLS], int rows, int cols) {
    printf("\n️ Displaying the Matrix:\n");
    for (int i = 0; i < rows; i++) {
        printf("│ ");
        for (int j = 0; j < cols; j++) {
            // Using %-6d to left-align numbers and keep columns visually tidy
            printf("%-6d ", matrix[i][j]);
        }
        printf("│\n");
    }
}
