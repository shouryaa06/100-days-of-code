#include <stdio.h>
#include <string.h>
#include <stdlib.h>


int is_rotation(const char str1[], const char str2[]) {
    int len1 = strlen(str1);
    int len2 = strlen(str2);

    // 1. If lengths are different, they cannot be rotations of each other
    if (len1 != len2) {
        return 0;
    }
    
    // An empty string is technically a rotation of another empty string
    if (len1 == 0) {
        return 1;
    }

    // 2. Allocate memory for the concatenated string (size: 2 * len1 + 1)
    char *temp = (char *)malloc(sizeof(char) * (2 * len1 + 1));
    if (temp == NULL) {
        return 0; // Memory allocation failed
    }

    // 3. Create the concatenated string: temp = str1 + str1
    strcpy(temp, str1);
    strcat(temp, str1);

    // 4. Check if str2 is a substring of the concatenated string
    int result = 0;
    if (strstr(temp, str2) != NULL) {
        result = 1; // Found! str2 is a rotation of str1
    }

    // Free dynamically allocated memory to prevent memory leaks
    free(temp);

    return result;
}
