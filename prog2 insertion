#include <stdio.h>

int main()
{
    int i,n,num,pos,arr[10];
    printf("Integer the number of elements int the array");
    scanf("%d",& n);
    printf ("\n enter the value");
    for (i=0;i<n;i++)
    {
        scanf ("%d", & arr[i]);
    }
    printf("\n enter the number to be inserted");
    scanf ("% d",& num);
    printf ("\n enter the position at which number to be added");
