#include <stdio.h>

int main()
{
    int a[100], n, i;
    int total = 0, leftSum = 0;
    int pivot = -1;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
        total = total + a[i];
    }

    for(i = 0; i < n; i++)
    {
        int rightSum = total - leftSum - a[i];

        if(leftSum == rightSum)
        {
            pivot = i;
            break;
        }

        leftSum = leftSum + a[i];
    }

    printf("Pivot index = %d", pivot);

    return 0;
}
