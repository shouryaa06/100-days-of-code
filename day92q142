#include <stdio.h>

struct Student {
    char name[50];
    int roll_no;
    float marks;
};

int main() {
    struct Student s[5];
    int i;

    for(i = 0; i < 5; i++) {
        printf("Enter name, roll number and marks: ");
        scanf("%s %d %f",
              s[i].name,
              &s[i].roll_no,
              &s[i].marks);
    }

    printf("\nAll Student Details:\n");

    for(i = 0; i < 5; i++) {
        printf("\nName: %s", s[i].name);
        printf("\nRoll No: %d", s[i].roll_no);
        printf("\nMarks: %.2f\n", s[i].marks);
    }

    return 0;
}
