#include <stdio.h>


void to_uppercase(char str[]) {
    int i = 0;
    
    // Traverse the string until the null-terminator '\0' is reached
    while (str[i] != '\0') {
        // If the character is lowercase (ASCII 97 to 122)
        if (str[i] >= 'a' && str[i] <= 'z') {
            // Subtract 32 to convert it to its uppercase counterpart
            str[i] = str[i] - 32;
        }
        i++;
    }
}
