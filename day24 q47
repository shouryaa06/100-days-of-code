#include <iostream>

using namespace std;

int main() {
    int totalRows = 5;

    // Outer loop for rows
    for (int i = 1; i <= totalRows; ++i) {
        // Inner loop to print 'i' stars in the i-th row
        for (int j = 1; j <= i; ++j) {
            cout << "*";
        }
        // Move to the next line after printing all stars in the current row
        cout << endl;
    }

    return 0;
}
