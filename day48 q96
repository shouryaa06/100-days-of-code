#include <stdio.h>

/**
 * Helper function to reverse a segment of a string in-place.
 * 
 * @param str   The input string.
 * @param start The starting index of the segment.
 * @param end   The ending index of the segment.
 */
void reverse_segment(char str[], int start, int end) {
    while (start < end) {
        char temp = str[start];
        str[start] = str[end];
        str[end] = temp;
        start++;
        end--;
    }
}

/**
 * Reverses each individual word in a sentence without changing the word order.
 * 
 * @param sentence The null-terminated sentence to modify in-place.
 */
void reverse_words(char sentence[]) {
    int i = 0;
    
    while (sentence[i] != '\0') {
        // Skip any leading spaces or delimiters to find the start of the next word
        while (sentence[i] == ' ' || sentence[i] == '\t' || sentence[i] == '\n') {
            i++;
        }
        
        // If we hit the end of the sentence, break out
        if (sentence[i] == '\0') {
            break;
        }
        
        int start = i;
        
        // Move forward until we find a delimiter or the end of the string
        while (sentence[i] != '\0' && sentence[i] != ' ' && sentence[i] != '\t' && sentence[i] != '\n') {
            i++;
        }
        
        int end = i - 1;
        
        // Reverse the single word we just extracted
        reverse_segment(sentence, start, end);
    }
}

