#include <stdio.h>
#include <stdlib.h> // Required for abs()

int main() {
    int num, activeNum;

    // Prompt user for input
    printf("Enter an integer: ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    // Handle edge case for 0
    if (num == 0) {
        printf("Every non-zero integer is a factor of 0.\n");
        return 0;
    }

    // Use absolute value to correctly process negative numbers
    activeNum = abs(num);

    printf("The factors of %d are: ", num);

    // Loop to find and print factors
    for (int i = 1; i <= activeNum; i++) {
        if (activeNum % i == 0) {
            printf("%d ", i);
        }
    }
    printf("\n");

    return 0;
}
