#include <stdio.h>

#define MAX_ROWS 100
#define MAX_COLS 100


void calculate_row_sums(int matrix[MAX_ROWS][MAX_COLS], int rows, int cols, int row_sums[]) {
    for (int i = 0; i < rows; i++) {
        int current_row_sum = 0;
        
        for (int j = 0; j < cols; j++) {
            current_row_sum += matrix[i][j];
        }
        
        // Store the calculated sum in the respective index of the 1D array
        row_sums[i] = current_row_sum;
    }
}

// Helper function to print a matrix in a clean, aligned grid format
void print_matrix(int matrix[MAX_ROWS][MAX_COLS], int rows, int cols) {
    for (int i = 0; i < rows; i++) {
        printf("│ ");
        for (int j = 0; j < cols; j++) {
            printf("%-6d ", matrix[i][j]);
        }
        printf("│\n");
    }
}
