#include <stdio.h>


int insert_at_position(int arr[], int size, int capacity, int val, int pos) {
    // 1. Check if the array is already at max capacity
    if (size >= capacity) {
        printf("Error: Array capacity exceeded. Cannot insert.\n");
        return -1;
    }
    
    // 2. Check if the position is out of bounds
    if (pos < 0 || pos > size) {
        printf("Error: Position %d is out of bounds (Valid: 0 to %d).\n", pos, size);
        return -1;
    }
    
    // 3. Shift elements to the right from the end down to the target position
    for (int i = size; i > pos; i--) {
        arr[i] = arr[i - 1];
    }
    
    // 4. Place the new value at the specified position
    arr[pos] = val;
    
    // 5. Return the updated size
    return size + 1;
}

// Helper function to print an array
void print_array(const int arr[], int size) {
    printf("[");
    for (int i = 0; i < size; i++) {
        printf("%d", arr[i]);
        if (i < size - 1) {
            printf(", ");
        }
    }
    printf("]\n");
}

