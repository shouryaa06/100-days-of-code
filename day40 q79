#include <stdio.h>

int main()
{
    int a[10][10], r, c, i, j, k;

    printf("Enter number of rows: ");
    scanf("%d", &r);

    printf("Enter number of columns: ");
    scanf("%d", &c);

    printf("Enter matrix elements:\n");

    // Read matrix
    for(i = 0; i < r; i++)
    {
        for(j = 0; j < c; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Diagonal traversal:\n");

    for(k = 0; k < r + c - 1; k++)
    {
        if(k % 2 == 0)
        {
            i = (k < r) ? k : r - 1;
            j = k - i;

            while(i >= 0 && j < c)
            {
                printf("%d ", a[i][j]);
                i--;
                j++;
            }
        }
        else
        {
            j = (k < c) ? k : c - 1;
            i = k - j;

            while(j >= 0 && i < r)
            {
                printf("%d ", a[i][j]);
                i++;
                j--;
            }
        }
    }

    return 0;
}
