#include <iostream>

using namespace std;

int main() {
    int rows = 5;
    int columns = 5;

    // Outer loop for rows
    for (int i = 0; i < rows; ++i) {
        // Inner loop for columns
        for (int j = 0; j < columns; ++j) {
            cout << "*";
        }
        // Move to the next line after printing each row
        cout << endl;
    }

    return 0;
}
