#include <iostream>
#include <iomanip>

using namespace std;

int main() {
    int n;
    cout << "Enter the number of terms (n): ";
    if (!(cin >> n) || n <= 0) {
        cout << "Please enter a valid positive integer." << endl;
        return 1;
    }

    double sum = 0.0;

    for (int i = 1; i <= n; ++i) {
        if (i == 1) {
            sum += 1.0; // First term is 1
        } else {
            double numerator = 2 * i - 1;
            double denominator = 2 * i - 2;
            sum += numerator / denominator;
        }
    }

    // Print result with high precision
    cout << fixed << setprecision(6);
    cout << "Sum of " << n << " terms is: " << sum << endl;

    return 0;
}
