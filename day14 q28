#include <stdio.h>

int main() {
    int n;
    unsigned long long product = 1; // Using unsigned long long to handle larger products
    int has_even = 0;

    // Prompt user for input
    printf("Enter the value of n: ");
    if (scanf("%d", &n) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    // Calculate product of even numbers
    for (int i = 1; i <= n; i++) {
        if (i % 2 == 0) {
            product *= i;
            has_even = 1;
        }
    }

    // Print the result
    if (has_even) {
        printf("The product of even numbers from 1 to %d is: %llu\n", n, product);
    } else {
        printf("There are no even numbers in the range 1 to %d.\n", n);
    }

    return 0;
}
