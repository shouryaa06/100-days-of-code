#include <iostream>

using namespace std;

int main() {
    int totalRows = 5;

    // Outer loop to handle the number of rows
    for (int i = 1; i <= totalRows; ++i) {
        // Inner loop to print numbers from 1 up to the current row number 'i'
        for (int j = 1; j <= i; ++j) {
            cout << j;
        }
        // Move to the next line after printing the row sequence
        cout << endl;
    }

    return 0;
}
