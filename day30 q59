#include <iostream>

using namespace std;

int main() {
    int n;
    cout << "Enter the number of elements: ";
    if (!(cin >> n) || n <= 0) {
        cout << "Please enter a valid positive integer." << endl;
        return 1;
    }

    int arr[n];
    int evenCount = 0;
    int oddCount = 0;

    cout << "Enter " << n << " elements:" << endl;
    for (int i = 0; i < n; ++i) {
        if (!(cin >> arr[i])) {
            cout << "Invalid input. Exiting." << endl;
            return 1;
        }

        // Check if the current element is even or odd
        if (arr[i] % 2 == 0) {
            evenCount++;
        } else {
            oddCount++;
        }
    }

    // Output the results
    cout << "\nTotal even numbers: " << evenCount << endl;
    cout << "Total odd numbers: " << oddCount << endl;

    return 0;
}

