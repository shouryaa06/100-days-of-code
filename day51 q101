#include <stdio.h>

int main()
{
    int nums[100], n, target;
    int low, high, mid;
    int first = -1, last = -1, i;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter sorted array elements:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }

    printf("Enter target element: ");
    scanf("%d", &target);

    // Find first occurrence
    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = low + (high - low) / 2;

        if(nums[mid] == target)
        {
            first = mid;
            high = mid - 1;
        }
        else if(nums[mid] < target)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    // Find last occurrence
    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = low + (high - low) / 2;

        if(nums[mid] == target)
        {
            last = mid;
            low = mid + 1;
        }
        else if(nums[mid] < target)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    if(first == -1)
    {
        printf("-1, -1");
    }
    else
    {
        printf("First occurrence: %d\n", nums[first]);
        printf("Last occurrence: %d\n", nums[last]);

        printf("First index: %d\n", first);
        printf("Last index: %d\n", last);
    }

    return 0;
}
