#include <iostream>

using namespace std;

int main() {
    int n;
    cout << "Enter the number of elements: ";
    if (!(cin >> n) || n <= 0) {
        cout << "Please enter a valid positive integer size." << endl;
        return 1;
    }

    int arr[n];
    long long sum = 0; // Using long long to prevent integer overflow

    cout << "Enter " << n << " elements:" << endl;
    for (int i = 0; i < n; ++i) {
        if (!(cin >> arr[i])) {
            cout << "Invalid input. Exiting." << endl;
            return 1;
        }
        sum += arr[i]; // Accumulate sum during input retrieval
    }

    cout << "\nSum of all array elements is: " << sum << endl;

    return 0;
}
