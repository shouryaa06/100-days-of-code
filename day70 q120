#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[1000];

    fgets(str, sizeof(str), stdin);

    int i = 0;

    while (str[i] != '\0' && str[i] != '\n') {
        if (i == 0) {
            str[i] = toupper((unsigned char)str[i]);
        } else {
            str[i] = tolower((unsigned char)str[i]);
        }

        i++;
    }

    printf("%s", str);

    return 0;
}
