#include <stdio.h>

int main()
{
    int n, i;

    scanf("%d", &n);

    int nums[n], answer[n];

    for (i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }

    // Calculate prefix product
    answer[0] = 1;

    for (i = 1; i < n; i++)
    {
        answer[i] = answer[i - 1] * nums[i - 1];
    }

    // Calculate suffix product
    int suffix = 1;

    for (i = n - 1; i >= 0; i--)
    {
        answer[i] = answer[i] * suffix;
        suffix = suffix * nums[i];
    }

    for (i = 0; i < n; i++)
    {
        printf("%d ", answer[i]);
    }

    return 0;
}
