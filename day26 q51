#include <iostream>

using namespace std;

int main() {
    int totalRows = 5;

    // Outer loop for the rows
    for (int i = 1; i <= totalRows; ++i) {
        
        // Inner loop 1: Print (totalRows - i) leading spaces
        for (int space = 1; space <= totalRows - i; ++space) {
            cout << " ";
        }
        
        // Calculate the starting number for the current row
        int startValue = totalRows - i + 1;
        
        // Inner loop 2: Print numbers from startValue up to totalRows
        for (int j = startValue; j <= totalRows; ++j) {
            cout << j;
        }
        
        // Move to the next line after completing the row
        cout << endl;
    }

    return 0;
}
