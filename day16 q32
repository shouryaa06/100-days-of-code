#include <stdio.h>

int main() {
    int num, originalNum;
    int reversedNum = 0;

    // Prompt user for input
    printf("Enter an integer: ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    // Negative numbers are mathematically not palindromes (due to the '-' sign at the start)
    if (num < 0) {
        printf("%d is NOT a palindrome number.\n", num);
        return 0;
    }

    originalNum = num; // Store the original number for comparison later

    // Reverse the number
    while (num != 0) {
        int remainder = num % 10;
        
        // Check for potential integer overflow before multiplying
        if (reversedNum > 2147483647 / 10 || (reversedNum == 2147483647 / 10 && remainder > 7)) {
            printf("Error: Number is too large, reversal caused integer overflow.\n");
            return 1;
        }

        reversedNum = reversedNum * 10 + remainder;
        num /= 10;
    }

    // Compare original number with the reversed number
    if (originalNum == reversedNum) {
        printf("%d is a palindrome number.\n", originalNum);
    } else {
        printf("%d is NOT a palindrome number.\n", originalNum);
    }

    return 0;
}
