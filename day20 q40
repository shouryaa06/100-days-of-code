#include <stdio.h>

int main() {
    long long binaryNum, originalNum;
    long long complement = 0;
    long long placeValue = 1;
    int isValid = 1;

    // Prompt user for input
    printf("Enter a binary number (containing only 0s and 1s): ");
    if (scanf("%lld", &binaryNum) != 1 || binaryNum < 0) {
        printf("Invalid input.\n");
        return 1;
    }

    originalNum = binaryNum;

    // Process each digit mathematically
    while (binaryNum != 0) {
        int bit = binaryNum % 10;

        // Validation check to ensure input is strictly binary
        if (bit != 0 && bit != 1) {
            isValid = 0;
            break;
        }

        // Invert the bit: (1 - 0 = 1) and (1 - 1 = 0)
        int invertedBit = 1 - bit;

        // Place the inverted bit in its respective position
        complement = complement + (invertedBit * placeValue);
        
        placeValue *= 10;
        binaryNum /= 10;
    }

    // Print results
    if (!isValid) {
        printf("Error: Input is not a valid binary number.\n");
    } else if (originalNum == 0) {
        // Special case for zero
        printf("The 1's complement of 0 is: 1\n");
    } else {
        printf("Original binary: %lld\n", originalNum);
        printf("1's complement : %lld\n", complement);
    }

    return 0;
}
